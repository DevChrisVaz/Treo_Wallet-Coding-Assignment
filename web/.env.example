# Copia este archivo a .env.local y ajusta los valores. Todas son variables del servidor:
# ninguna lleva el prefijo NEXT_PUBLIC_ y ninguna llega al navegador.

# Origen de la API (sin ruta). Obligatoria en producción; en desarrollo vale http://localhost:4000.
API_BASE_URL=http://localhost:4000

# Orígenes adicionales, separados por comas, desde los que se aceptan Server Actions
# (por ejemplo, el dominio público cuando la web corre detrás de un proxy). Vacío = solo el propio.
ALLOWED_ORIGINS=

# true cuando la web se sirve por HTTPS: cookie __Host-sid con Secure. Por defecto true en
# producción y false en desarrollo (Safari rechaza cookies Secure en http://localhost).
SESSION_COOKIE_SECURE=false

# Minutos de inactividad tras los que expira la sesión.
SESSION_IDLE_MINUTES=15

# Redis para las sesiones del BFF (redis:// o rediss://). Con ella, las sesiones sobreviven al
# reinicio del servidor; vacía, viven en la memoria del proceso. Redis local: `docker compose up -d`.
REDIS_URL=redis://localhost:6379
