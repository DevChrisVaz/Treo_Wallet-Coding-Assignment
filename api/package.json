{
  "name": "wallet-api",
  "version": "0.1.0",
  "description": "API de la billetera digital en MXN: identidad, cuentas, beneficiarios, transferencias e historial.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/db-bootstrap.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:revert": "tsx --env-file-if-exists=.env scripts/db-revert.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts"
  },
  "dependencies": {
    "@devchrisvaz/wallet-contract": "file:../contract",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
