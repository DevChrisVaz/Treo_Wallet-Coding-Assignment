{
  "name": "wallet-api",
  "version": "0.1.0",
  "description": "API de la billetera digital en MXN: identidad, cuentas, beneficiarios, transferencias e historial.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/db-bootstrap.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:revert": "tsx --env-file-if-exists=.env scripts/db-revert.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts",
    "db:fund": "tsx --env-file-if-exists=.env scripts/db-fund.ts"
  },
  "dependencies": {
    "@devchrisvaz/wallet-contract": "file:../contract",
    "@devchrisvaz/wallet-design-tokens": "file:../design-tokens",
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
