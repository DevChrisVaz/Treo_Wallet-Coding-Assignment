# Configuración de desarrollo local de /api. Copia este archivo a `.env`.
# Todos los valores son SOLO de desarrollo: en AWS vienen de Secrets Manager / variables de la tarea.
# Los secretos van en base64 y deben decodificar a 32 bytes o más (genéralos con `openssl rand -base64 32`).

NODE_ENV=development
# 0.0.0.0 para que la app móvil alcance la API por la red local.
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL de docker compose (publicado en el puerto 5433 del host).
POSTGRES_PORT=5433
# Rol de ejecución de la API (privilegio mínimo).
DATABASE_URL=postgres://wallet_app:wallet_app_dev_password@localhost:5433/wallet
# Rol dueño del esquema: migraciones y seed.
MIGRATION_DATABASE_URL=postgres://wallet_migrator:wallet_migrator_dev_password@localhost:5433/wallet
# Superusuario: solo para `npm run db:bootstrap` (crea roles y bases).
BOOTSTRAP_DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5433/postgres
WALLET_MIGRATOR_PASSWORD=wallet_migrator_dev_password
WALLET_APP_PASSWORD=wallet_app_dev_password

# Base de pruebas de integración (creada por db:bootstrap).
TEST_DATABASE_URL=postgres://wallet_app:wallet_app_dev_password@localhost:5433/wallet_test
TEST_MIGRATION_DATABASE_URL=postgres://wallet_migrator:wallet_migrator_dev_password@localhost:5433/wallet_test

# Tokens y códigos de un solo uso.
JWT_SECRET=ZGV2LW9ubHktand0LXNlY3JldC1kby1ub3QtdXNlLWluLXByb2Q=
JWT_ISSUER=wallet-api
JWT_AUDIENCE=wallet-clients
OTP_HMAC_SECRET=ZGV2LW9ubHktb3RwLWhtYWMtc2VjcmV0LW5vdC1mb3ItcHJvZCE=

# CLABE de las cuentas: 999 no corresponde a ninguna institución del catálogo de participantes
# del SPEI de Banxico (verificado el 2026-10-13); 180 es el código de plaza fijo.
CLABE_BANK_CODE=999
CLABE_PLAZA_CODE=180

# Correo: Mailpit en local (bandeja web en http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Billetera <no-reply@wallet.local>
# Solo con un servidor que pide autenticación (Amazon SES por SMTP); Mailpit no las usa.
# SMTP_USER=
# SMTP_PASSWORD=

# Proxies cuyo X-Forwarded-For se respeta: loopback en local (el BFF corre en la misma máquina).
TRUSTED_PROXIES=loopback

# Transferencias: límite diario a terceros por usuario (día de CDMX) y OTP para montos mayores al umbral.
DAILY_TRANSFER_LIMIT=50000.00
OTP_THRESHOLD=10000.00
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=3
# Firma de los cursores de paginación del historial.
CURSOR_SIGNING_SECRET=ZGV2LW9ubHktY3Vyc29yLXNlY3JldC1ub3QtZm9yLXByb2QhISE=

# Ejecutor de transferencias programadas: una pasada al arrancar y luego cada intervalo (1000 a
# 3600000 ms), una a la vez por instancia, en lotes. Bájalo a 5000 para verlas ejecutarse en local.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_BATCH_SIZE=100

# Límites de tasa (peticiones por ventana, entero de 1 a 10000). Refresh y logout cuentan por IP
# (ventana de 15 min); las transferencias, por usuario (crear y cancelar 10 min; confirmar y reenviar
# 15 min). Las repeticiones de una llave de idempotencia también cuentan.
RATE_LIMIT_REFRESH_MAX=120
RATE_LIMIT_LOGOUT_MAX=60
RATE_LIMIT_TRANSFER_CREATE_MAX=30
RATE_LIMIT_TRANSFER_CONFIRM_MAX=15
RATE_LIMIT_TRANSFER_RESEND_MAX=6
RATE_LIMIT_TRANSFER_CANCEL_MAX=20
