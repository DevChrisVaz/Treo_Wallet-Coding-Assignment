# URL de la API local vista desde el teléfono o el simulador (MOB-17).
# Expo Go en un teléfono: la IP de tu equipo en la red local (la API escucha en 0.0.0.0:4000).
EXPO_PUBLIC_API_URL=http://192.168.1.50:4000
# Emulador de Android: EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Simulador de iOS: EXPO_PUBLIC_API_URL=http://localhost:4000
