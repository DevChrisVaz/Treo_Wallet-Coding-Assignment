# Backend de stack/ para staging. Bucket y llave salen de los outputs de bootstrap/ en la cuenta de staging.
bucket       = "treo-staging-tfstate-000000000000"
key          = "stack/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:000000000000:alias/treo-staging-terraform-state"
use_lockfile = true
