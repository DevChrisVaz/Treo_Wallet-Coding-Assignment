# Backend de stack/ para dev. Bucket y llave salen de los outputs de bootstrap/ en la cuenta de dev.
bucket       = "treo-dev-tfstate-000000000000"
key          = "stack/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:000000000000:alias/treo-dev-terraform-state"
use_lockfile = true
