{
  "name": "@morgandevchrisvaz/wallet-contract",
  "version": "1.0.0",
  "description": "Contrato OpenAPI de la billetera: tipos generados, cliente tipado, validadores compartidos y formato de montos.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openapi.yaml": "./openapi.yaml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:contract": "redocly lint openapi.yaml",
    "check:version": "node scripts/check-version.mjs",
    "generate": "openapi-typescript openapi.yaml -o src/generated/api.d.ts",
    "check:exports": "node scripts/check-exports.mjs",
    "check:no-node-imports": "node scripts/check-no-node-imports.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.63.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
